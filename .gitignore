.env
.env.*
!.env.example
node_modules/
dist/
.cache/
.DS_Store
.data/

# Web production build
apps/web/build/
apps/web/.react-router/

# Font package unpacked to regenerate the report nameplates (docs/customize.md)
package/
fontsource-noto-sans-sc-*.tgz

# Local working scratch — CI log captures, probe output, one-off scripts.
# Never committed: some hold tokens or raw third-party page dumps.
.m2cache/

# Cloudflare Worker deployment for the static report mirror. deploy.mjs embeds a
# Cloudflare API token, so this directory must stay out of the repository.
cf-worker/

# Throwaway probe/import scripts used while sourcing and validating the source
# pack. They are not part of the product build.
scripts/_*.mjs
scripts/deep-probe*.mjs
scripts/probe-*.mjs
scripts/m2-*.json
scripts/m2-*.result.json
scripts/m2-*.mjs
scripts/m3-*.result.json
scripts/m3-*.mjs
scripts/m4-*.json
scripts/m4-*.result.json
scripts/m4-*.mjs
# The validators are product tooling, not throwaway probes: keep them tracked.
!scripts/m2-validate.mjs
!scripts/m3-validate-all.mjs
!scripts/check-threshold-consistency.mjs
